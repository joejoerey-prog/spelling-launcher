# Optional: LLM API key for advanced passage rewriting (never full doc)
# If left unset, the app runs completely offline with high-performance local deterministic heuristics!
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# Alternative: Local Ollama / Anthropic
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_ANTHROPIC_API_KEY=
